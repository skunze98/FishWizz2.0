{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishwizz.dev/schema/angling-category.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["slug", "label", "record_status", "created_at", "updated_at", "schema_version", "content_version"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z_]+$" },
    "label": { "type": "string", "minLength": 1 },
    "record_status": { "$ref": "shared-definitions.schema.json#/$defs/record_status_enum" },
    "created_at": { "$ref": "shared-definitions.schema.json#/$defs/date_time" },
    "updated_at": { "$ref": "shared-definitions.schema.json#/$defs/date_time" },
    "schema_version": { "type": "string", "const": "3.0.0" },
    "content_version": { "type": "integer", "minimum": 1 }
  }
}
