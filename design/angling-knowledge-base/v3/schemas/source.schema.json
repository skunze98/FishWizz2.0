{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishwizz.dev/schema/source.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["id", "title", "organization", "url", "publication_date", "access_date",
    "source_type", "geographic_relevance", "record_status", "content_fingerprint",
    "created_at", "updated_at", "published_at", "schema_version", "content_version"],
  "properties": {
    "id": { "$ref": "shared-definitions.schema.json#/$defs/uuid" },
    "title": { "type": "string", "minLength": 1 },
    "organization": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "publication_date": { "type": ["string", "null"], "format": "date" },
    "access_date": { "$ref": "shared-definitions.schema.json#/$defs/date" },
    "source_type": { "$ref": "shared-definitions.schema.json#/$defs/evidence_type_enum" },
    "geographic_relevance": { "enum": ["MN", "WI", "MN_WI_boundary", "great_lakes", "national"] },
    "record_status": { "$ref": "shared-definitions.schema.json#/$defs/record_status_enum" },
    "content_fingerprint": { "$ref": "shared-definitions.schema.json#/$defs/sha256_hex" },
    "created_at": { "$ref": "shared-definitions.schema.json#/$defs/date_time" },
    "updated_at": { "$ref": "shared-definitions.schema.json#/$defs/date_time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "schema_version": { "type": "string", "const": "3.0.0" },
    "content_version": { "type": "integer", "minimum": 1 }
  },
  "if": { "properties": { "record_status": { "const": "published" } } },
  "then": { "required": ["published_at"], "properties": { "published_at": { "type": "string" } } }
}
