{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishwizz.dev/schema/gear-compatibility-profile.schema.json",
  "description": "Fixes gate-2's defect: presentation_gear_compatibility had presentation_id as its PRIMARY KEY, allowing only one profile per presentation. A presentation (e.g. 'crankbait') legitimately has several valid equipment profiles (light spinning for a small shallow crank, medium-heavy casting for a deep-diving glass crank). Own id; many rows per presentation_id.",
  "type": "object", "additionalProperties": false,
  "required": ["id", "presentation_id", "label", "reel_type", "rod_power_min", "rod_power_max",
    "rod_action_min", "rod_action_max", "rod_length_in", "line_material", "line_test_lb",
    "leader_required", "leader_material", "leader_length_in", "lure_weight_oz",
    "environment_applicability", "record_status", "content_fingerprint",
    "created_at", "updated_at", "published_at", "schema_version", "content_version"],
  "properties": {
    "id": { "$ref": "shared-definitions.schema.json#/$defs/uuid" },
    "presentation_id": { "$ref": "shared-definitions.schema.json#/$defs/uuid" },
    "label": { "type": "string", "minLength": 1, "description": "e.g. 'light finesse setup' vs 'deep-diver casting setup' -- distinguishes multiple profiles on the same presentation." },
    "reel_type": { "$ref": "shared-definitions.schema.json#/$defs/reel_type_enum" },
    "rod_power_min": { "$ref": "shared-definitions.schema.json#/$defs/rod_power_enum" },
    "rod_power_max": { "$ref": "shared-definitions.schema.json#/$defs/rod_power_enum" },
    "rod_action_min": { "$ref": "shared-definitions.schema.json#/$defs/rod_action_enum" },
    "rod_action_max": { "$ref": "shared-definitions.schema.json#/$defs/rod_action_enum" },
    "rod_length_in": { "anyOf": [{ "$ref": "shared-definitions.schema.json#/$defs/range" }, { "type": "null" }],
      "description": "Null when rod length isn't a meaningful axis for this presentation (e.g. most jig presentations); non-null when it is (musky, surf, trolling)." },
    "line_material": { "$ref": "shared-definitions.schema.json#/$defs/line_material_enum" },
    "line_test_lb": { "$ref": "shared-definitions.schema.json#/$defs/range" },
    "leader_required": { "type": "boolean" },
    "leader_material": { "anyOf": [{ "enum": ["fluorocarbon", "steel", "heavy_mono"] }, { "type": "null" }] },
    "leader_length_in": { "anyOf": [{ "$ref": "shared-definitions.schema.json#/$defs/range" }, { "type": "null" }] },
    "lure_weight_oz": { "$ref": "shared-definitions.schema.json#/$defs/range" },
    "environment_applicability": { "$ref": "shared-definitions.schema.json#/$defs/environment_applicability" },
    "record_status": { "$ref": "shared-definitions.schema.json#/$defs/record_status_enum" },
    "content_fingerprint": { "$ref": "shared-definitions.schema.json#/$defs/sha256_hex" },
    "created_at": { "$ref": "shared-definitions.schema.json#/$defs/date_time" },
    "updated_at": { "$ref": "shared-definitions.schema.json#/$defs/date_time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "schema_version": { "type": "string", "const": "3.0.0" },
    "content_version": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    { "if": { "properties": { "leader_required": { "const": true } } },
      "then": { "required": ["leader_material", "leader_length_in"], "properties": { "leader_material": { "type": "string" } } } },
    { "if": { "properties": { "leader_required": { "const": false } } },
      "then": { "properties": { "leader_material": { "const": null }, "leader_length_in": { "const": null } } } },
    { "if": { "properties": { "record_status": { "const": "published" } } }, "then": { "required": ["published_at"] } }
  ]
}
