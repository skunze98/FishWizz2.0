# FishWizz runs against TWO Supabase projects.
#
#   production   usanapexwjssjscmdjwv.supabase.co   -- www.fishwizz.com
#   staging      doddeferfxzgdmzadibq.supabase.co   -- previews and local dev
#
# Copy this file to .env for local work. It points at STAGING on purpose:
# local development should never be one typo away from production data.
#
# On Cloudflare Pages these are set per environment under
# Settings -> Environment variables (see DEPLOYMENT.md):
#   Production environment -> the production project
#   Preview environment    -> the staging project
#
# The publishable key is public by design -- it identifies the project, it does
# not authorize anything. Row Level Security is what protects the data (see
# supabase/migrations/). These are env vars for swappability, not secrecy.
#
# The build fails if the origin in the CSP and the origin baked into the bundle
# disagree, so a half-changed environment cannot ship.

VITE_SUPABASE_URL=https://doddeferfxzgdmzadibq.supabase.co
VITE_SUPABASE_ANON=sb_publishable_aRBM4TvuGEUAdOZazPoZLw_CXdoEtpp

# --- Turnstile (DEPLOYMENT.md step 5) -------------------------------------
# The Turnstile SITE key, not the secret -- this one is meant to be public,
# it's embedded in the page like the Supabase publishable key above. The
# secret half never goes in this repo; it's pasted directly into Supabase
# (Authentication -> Attack protection), which is what actually verifies the
# token this produces. Leave blank until you've created a Turnstile widget:
# the frontend renders no widget and sends no captchaToken when it's empty,
# so signup/signin behave exactly as they do today.
VITE_TURNSTILE_SITE_KEY=

# --- Sentry (DEPLOYMENT.md step 8) ----------------------------------------
# Client error monitoring. Leave blank to keep it fully inert (no script
# load, no init call, no network). Once set, public/_headers.template's
# connect-src also needs your Sentry project's ingest origin added -- it's
# per-org, so it isn't pre-added the way Turnstile's fixed origin is.
VITE_SENTRY_DSN=

# --- scripts/rls-probe.mjs -----------------------------------------------
# Point this at whichever project you are hardening. Run it against STAGING
# first, then against production once the migration is applied there too.
# Use throwaway accounts. Never commit a real .env.

FISHWIZZ_SUPABASE_URL=https://doddeferfxzgdmzadibq.supabase.co
FISHWIZZ_SUPABASE_KEY=sb_publishable_aRBM4TvuGEUAdOZazPoZLw_CXdoEtpp
FISHWIZZ_PROBE_A_EMAIL=
FISHWIZZ_PROBE_A_PASS=
FISHWIZZ_PROBE_B_EMAIL=
FISHWIZZ_PROBE_B_PASS=
